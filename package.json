{
  "name": "lanterns-of-the-hollow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5195 --strictPort",
    "build": "tsc --noEmit && vite build",
